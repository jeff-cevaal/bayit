# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export KUBECONFIG=~/.kube/config

# neovim
if command -v nvim > /dev/null ; then
  export EDITOR="nvim"
  export VISUAL="nvim"
fi

# activate mise
if command -v mise > /dev/null ; then
  eval "$($HOME/.local/bin/mise activate zsh)"
fi

# CachyOS config
if [[ -r "/usr/share/cachyos-zsh-config/cachyos-config.zsh" ]]; then
  source /usr/share/cachyos-zsh-config/cachyos-config.zsh
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
export PATH="$HOME/.local/bin:$PATH"

# global default - main ssh agent
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"

# load main ssh agent keys
for key in homelab-servers github-account github-kahal-flux github-bayit; do
  ssh-add -l 2>/dev/null | grep -q "$key" || {
    if [ "$key" = "homelab-servers" ]; then
      ssh-add ~/.ssh/"$key" 2>/dev/null
    else
      ssh-add -c ~/.ssh/"$key" 2>/dev/null
    fi
  }
done

# load devpod ssh agent keys
for key in devpod-python github-bayit; do
  SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/devpod-agent.socket" ssh-add -l 2>/dev/null | grep -q "$key" || \
    SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/devpod-agent.socket" ssh-add -c ~/.ssh/"$key" 2>/dev/null
done

# isolated agent - devpod
devpod() {
  SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/devpod-agent.socket" command devpod "$@"
}
